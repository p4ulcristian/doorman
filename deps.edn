;; doorman: who is asking, and what may they do. Sessions in Postgres, and
;; access: scopes, roles, memberships, the check in front of every handler,
;; the gates (Postgres's row rules), the leak test. One tree: source-code/doorman/.
;; The server's; in the browser only the shape of "what may I do?"'s answer
;; (doorman.api's .cljs half).
{:paths ["source-code"]

 :deps
 {;; Postgres: the queries, the table maps and their gates
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked, an index as a map;
  ;; migrate! takes {:tables :extensions :functions :views}, a function a file or a made {:name :sql};
  ;; run-in-transaction! takes the caller's :log, where after-commit failures go
  io.github.p4ulcristian/cellar   {:git/tag "v0.4.6" :git/sha "4396e6b"}
  ;; a handler's steps: the session step and the check are steps; answer-message for the leak test;
  ;; refuse, and a handler's :refusals
  ;; on its tidy-up branch, not released: a refusal is a named reason, declared on its handler;
  ;; answer-message counts every message on the app's meter
  io.github.p4ulcristian/bridge {:git/tag "v0.7.8" :git/sha "90dd8fa"}
  ;; the step that finds the session adds the person to the message's log
  io.github.p4ulcristian/logbook  {:git/tag "v0.1.2" :git/sha "823f8fc"}
  ;; the settings and options checked by their shapes; the leak test: params
  ;; made by malli's generator, which needs test.check
  metosin/malli                  {:mvn/version "0.20.3"}
  org.clojure/test.check         {:mvn/version "1.1.3"}
  ;; who is asking, written as JSON for Postgres
  metosin/jsonista               {:mvn/version "1.0.2"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need DOORMAN_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the tests' meter, one per pool, made as an app makes its own (cellar brings the same)
                       io.github.p4ulcristian/meter {:git/tag "v0.1.4" :git/sha "bf81c46"}
                       ;; the tests' wire, made as an app makes its own (bridge brings the same)
                       io.github.p4ulcristian/wire {:git/tag "v0.2.1" :git/sha "900a84d"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
