;; doorman: who is asking, and what may they do. Sessions in Postgres, and
;; access: scopes, roles, memberships, the check in front of every handler,
;; the gates (Postgres's row rules), the leak test. One tree: source-code/doorman/.
;; The server's; in the browser only the shape of "what may I do?"'s answer
;; (doorman.api's .cljs half).
{:paths ["source-code"]

 :deps
 {;; Postgres: the queries, the table maps and their gates
  io.github.p4ulcristian/cellar   {:git/tag "v0.4.3" :git/sha "e164607"}
  ;; a handler's steps: the session step and the check are steps; answer-message for the leak test
  io.github.p4ulcristian/mailroom {:git/tag "v0.7.2" :git/sha "762e5c0"}
  ;; the step that finds the session adds the person to the message's log
  io.github.p4ulcristian/logbook  {:git/tag "v0.1.1" :git/sha "51a2c93"}
  ;; the settings and options checked by their shapes; the leak test: params
  ;; made by malli's generator, which needs test.check
  metosin/malli                  {:mvn/version "0.20.3"}
  org.clojure/test.check         {:mvn/version "1.1.3"}
  ;; who is asking, written as JSON for Postgres
  metosin/jsonista               {:mvn/version "1.0.2"}}

 :aliases
 {;; the tests:  clojure -X:test  (the Postgres ones need DOORMAN_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the tests' meter, one per pool, made as an app makes its own (cellar brings the same)
                       io.github.p4ulcristian/meter {:git/tag "v0.1.3" :git/sha "b71484d"}
                       ;; the tests' wire, made as an app makes its own (mailroom brings the same)
                       io.github.p4ulcristian/wire {:git/tag "v0.2.0" :git/sha "d66b7cb"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
